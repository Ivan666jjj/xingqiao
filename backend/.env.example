# 复制为 .env 后再改；不要提交真实值
XQ_DB=./data/xingqiao.db
XQ_ADMIN_TOKEN=change-me-admin
XQ_WEBHOOK_SECRET=change-me-webhook
XQ_RATE_LIMIT=120
XQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://xingqiao.localhost,http://localhost:8000,http://127.0.0.1:8000,null

# 千问：Key 建议放 macOS 钥匙串 qwen-dashscope-key，run.sh 会自动读取
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_TIMEOUT=60

# 前端“接入自己的 AI”里填这个 token；生产环境请换成随机值
XQ_CHAT_TOKEN=demo-chat-token